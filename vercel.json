{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300,
      "includeFiles": "data/secnev.snapshot.db"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 3 * * *"
    }
  ]
}
