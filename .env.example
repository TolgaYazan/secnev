PORT=8787
DB_PATH=./data/secnev.db
CKB_RPC_URL=https://mainnet.ckb.dev/
CKB_EXPLORER_URL=https://mainnet-api.explorer.nervos.org/api/v1
ADMIN_TOKEN=change-me
# Optional. The built-in RUSD price/liquidity adapter reads the UTXOSwap pool
# cell directly and does not need a key. The API adapter is only a fallback.
UTXOSWAP_API_KEY=
# Optional outbound alert delivery. The body is HMAC-SHA256 signed when the
# secret is set (x-secnev-signature: sha256=...).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Optional Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
# Optional SMTP email delivery.
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_SECURE=0
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Vercel: optional Blob-backed daily refresh
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Set by the Vercel bootstrap; useful for testing a read-only snapshot locally
DB_READ_ONLY=
# 0 = scan until the RPC returns an empty page (bounded by the time budget).
MAX_CELL_PAGES=0
CELL_SCAN_BUDGET_MS=180000
INGEST_TIMEOUT_MS=20000
