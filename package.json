{
  "name": "secnev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "secnev — CKB-native risk observatory (MVP)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "ingest": "tsx src/cli/ingest.ts",
    "replay": "tsx src/cli/replay.ts",
    "snapshot": "tsx src/cli/snapshot.ts",
    "webhook:test": "tsx src/cli/webhook-test.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.23.0",
    "@vercel/blob": "^2.9.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
